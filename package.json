{
  "name": "rcrdevelop",
  "version": "0.0.1",
  "private": true,
  "description": "Portafolio de Ricardo Contreras — desarrollador fullstack freelance: aplicaciones web y móviles con Vue, Quasar, Firebase y .NET.",
  "keywords": [
    "quasar",
    "quasar-app",
    "quasar-app-vite",
    "quasar-cli",
    "vite",
    "vue",
    "vuejs"
  ],
  "author": "devs-qodespace <dev@qodespace.com>",
  "type": "module",
  "scripts": {
    "lint": "oxfmt && oxlint --fix",
    "lint:check": "oxfmt --check && oxlint",
    "dev": "quasar dev",
    "build": "quasar build",
    "typecheck": "vue-tsc --noEmit",
    "postinstall": "quasar prepare --silent",
    "deploy": "quasar build && firebase deploy",
    "deploy:preview": "quasar build && firebase hosting:channel:deploy preview",
    "optimize:images": "node optimize-images.js",
    "optimize:replace": "node replace-optimized-images.js",
    "update:webp-refs": "node update-webp-refs.js"
  },
  "dependencies": {
    "@quasar/extras": "^2.1.0",
    "pinia": "^4.0.2",
    "quasar": "^2.32.3",
    "vue": "^3.5.22",
    "vue-i18n": "^11.3.0",
    "vue-router": "^5.0.6"
  },
  "devDependencies": {
    "@intlify/unplugin-vue-i18n": "^11.0.0",
    "@quasar/app-vite": "^3.8.4",
    "@types/node": "^22.19.11",
    "autoprefixer": "^10.4.27",
    "oxfmt": "^0.x",
    "oxlint": "^1.x",
    "oxlint-tsgolint": "^7.0.2001",
    "postcss": "^8.5.8",
    "sharp": "^0.33.5",
    "typescript": "^6.0.0",
    "vue-tsc": "^3.3.3"
  },
  "engines": {
    "node": ">= 26 || ^24 || ^22.12"
  },
  "productName": "RCR Develop — Portafolio de Ricardo Contreras"
}
